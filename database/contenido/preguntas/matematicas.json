        {
          "letra": "A",
          "texto": "1.000 + (1.000 × número de acompañamientos del helado).",
          "correcta": false,
          "retroalimentacion": null
        },
        {
          "letra": "B",
          "texto": "3.000 + (1.000 × número de acompañamientos del helado).",
          "correcta": true,
          "retroalimentacion": null
        },
        {
          "letra": "C",
          "texto": "1.000 + (3.000 × número de acompañamientos del helado).",
          "correcta": false,
          "retroalimentacion": null
        },
        {
          "letra": "D",
          "texto": "3.000 + (3.000 × número de acompañamientos del helado).",
          "correcta": false,
          "retroalimentacion": null
        }
      ],
      "explicacion": "",
      "tiempo_estimado_seg": 120,
      "etiquetas": []
    },
    {
