    {
      "codigo": "MAT-ECU-01",
      "subtema": "ecuaciones-basicas",
      "dificultad": 2,
      "competencia": null,
      "contexto_ref": null,
      "contexto": "En una heladería, cada vaso de helado cuesta $3.000. A cada vaso se le pueden agregar acompañamientos por un precio de $1.000 cada uno.",
