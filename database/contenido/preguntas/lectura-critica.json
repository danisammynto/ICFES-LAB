    {
      "codigo": "LEC-TIP-01",
      "subtema": "tipos-de-textos",
      "dificultad": 2,
      "competencia": null,
      "contexto_ref": null,
      "contexto": "Considere el siguiente fragmento del discurso de Gorbachov sobre la disolución de la Unión Soviética (1991): “El sistema totalitario, que privó al país de la oportunidad de ser exitoso y próspero, hace mucho tiempo que se ha eliminado. Un gran avance se ha logrado en el camino hacia el cambio democrático. Las elecciones libres, la libertad de prensa, las libertades religiosas, los órganos representativos del poder, el sistema multipartidista; todo esto se ha hecho realidad. Los Derechos Humanos son reconocidos como principio supremo. [...]”",
      "enunciado": "Basado en la información del fragmento, ¿cuál es la intención del autor de este discurso?",
      "imagen": null,
      "imagen_alt": null,
      "opciones": [
        {
          "letra": "A",
          "texto": "Justificar el fortalecimiento del totalitarismo como una oportunidad para el progreso económico del país y el reconocimiento internacional de la URSS.",
          "correcta": false,
          "retroalimentacion": null
        },
        {
          "letra": "B",
          "texto": "Denunciar que el sistema totalitario no le permitía al país ser un actor internacional relevante al influir en asuntos políticos y militares de otros países.",
          "correcta": false,
          "retroalimentacion": null
        },
        {
          "letra": "C",
          "texto": "Justificar los cambios políticos implementados en el país, en especial la eliminación del totalitarismo, para la construcción de una sociedad democrática.",
          "correcta": true,
          "retroalimentacion": null
        },
        {
          "letra": "D",
          "texto": "Denunciar que los sistemas democráticos no garantizaban el reconocimiento de los derechos humanos y la representación política de los ciudadanos.",
          "correcta": false,
          "retroalimentacion": null
        }
      ],
      "explicacion": "",
      "tiempo_estimado_seg": 120,
      "etiquetas": []
    },
