{
  "name": "icfes-lab",
  "version": "1.0.0",
  "description": "Plataforma educativa gamificada con IA para preparar la Prueba Saber 11 (ICFES).",
  "private": true,
  "type": "module",
  "main": "backend/src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "db:setup": "node backend/src/scripts/db-setup.js",
    "db:reset": "node backend/src/scripts/db-setup.js --reset",
    "db:seed": "node backend/src/scripts/db-seed.js",
    "db:demo": "node backend/src/scripts/db-demo.js",
    "db:sql": "node backend/src/scripts/generar-sql.js",
    "admin:crear": "node backend/src/scripts/crear-admin.js",
    "iconos": "node backend/src/scripts/generar-iconos.js",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:api": "node tests/api.smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "lucide-static": "^1.47.0"
  }
}
