# =============================================================================
#  ICFES Lab · Variables de entorno
#  Copia este archivo como .env y ajusta los valores.
# =============================================================================

# --- Servidor ----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# URL pública (se usa en los enlaces de recuperación de contraseña). Con https:// se activan
# la cookie Secure, HSTS y upgrade-insecure-requests. En una red local sin certificado usa
# la IP del servidor, por ejemplo http://192.168.1.10:3000.
APP_URL=http://localhost:3000
# Zona horaria para rachas y estadísticas diarias.
APP_TZ=America/Bogota
# Actívalo si la app corre detrás de un proxy (Nginx, Render, Railway…).
TRUST_PROXY=false

# --- Base de datos PostgreSQL ------------------------------------------------
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/icfeslab
# true para servicios en la nube que exigen SSL (Neon, Supabase, Render…).
DB_SSL=false

# --- Seguridad ---------------------------------------------------------------
# Obligatorio en producción (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# La cookie de sesión es "Secure" si APP_URL usa https:// o si la petición llega por HTTPS.
# true la fuerza siempre.
COOKIE_SECURE=false

# --- Vanty (IA tutora) ---------------------------------------------------------
# Sin ANTHROPIC_API_KEY, Vanty funciona en modo local (reglas + base de conocimiento).
# Obtén una clave en https://console.anthropic.com
ANTHROPIC_API_KEY=
# auto (Claude si hay clave) | claude | local
VANTY_PROVEEDOR=auto
VANTY_MODEL=claude-opus-5
# Nivel de esfuerzo del modelo: low | medium | high
VANTY_EFFORT=medium
# Reintento automático en el servidor de Anthropic si el modelo declina una solicitud.
VANTY_FALLBACKS=true

# --- Correo (recuperación de contraseña) -------------------------------------
# Sin SMTP, el enlace de recuperación se muestra en la consola del servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ICFES Lab <no-reply@tudominio.co>"
